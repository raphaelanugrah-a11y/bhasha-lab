rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Admin bootstrap check using configured owner email and DB lookup
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'raphaelanugrah@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // User profile validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['student', 'teacher', 'admin'] &&
             (!('assignedClass' in data) || (data.assignedClass is number && data.assignedClass >= 1 && data.assignedClass <= 12)) &&
             (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 128)) &&
             (!('totalXp' in data) || (data.totalXp is number && data.totalXp >= 0)) &&
             (!('streakDays' in data) || (data.streakDays is number && data.streakDays >= 0));
    }

    // Content entity validation
    function isValidContent(data) {
      return data.keys().hasAll(['id', 'language', 'section', 'classGrade', 'title', 'contentBody', 'authorId', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.language in ['english', 'hindi', 'sanskrit'] &&
             data.section in ['reading', 'pronunciation', 'listening', 'grammar'] &&
             data.classGrade is number && data.classGrade >= 1 && data.classGrade <= 12 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 250 &&
             data.contentBody is string && data.contentBody.size() > 0 && data.contentBody.size() <= 50000 &&
             data.authorId is string && data.authorId.size() <= 128 &&
             data.status in ['published', 'draft'] &&
             (!('difficulty' in data) || data.difficulty in ['beginner', 'intermediate', 'advanced']) &&
             (!('translation' in data) || (data.translation is string && data.translation.size() <= 20000)) &&
             (!('audioText' in data) || (data.audioText is string && data.audioText.size() <= 20000)) &&
             (!('phoneticGuide' in data) || (data.phoneticGuide is string && data.phoneticGuide.size() <= 10000)) &&
             (!('grammarNotes' in data) || (data.grammarNotes is string && data.grammarNotes.size() <= 20000));
    }

    // Progress record validation
    function isValidProgress(data) {
      return data.keys().hasAll(['id', 'userId', 'contentId', 'completed']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.contentId is string && data.contentId.size() <= 128 &&
             data.completed is bool &&
             (!('score' in data) || (data.score is number && data.score >= 0 && data.score <= 100));
    }

    // Match /admins/{adminId}
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    // Match /users/{userId}
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isValidId(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if isAdmin();
    }

    // Match /content/{contentId}
    match /content/{contentId} {
      allow get, list: if true;
      allow create: if isValidId(contentId) && isValidContent(incoming());
      allow update: if isValidId(contentId) && isValidContent(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // Match /userProgress/{progressId}
    match /userProgress/{progressId} {
      allow get, list: if true;
      allow create: if isValidId(progressId) && isValidProgress(incoming());
      allow update: if isValidId(progressId) && isValidProgress(incoming()) && incoming().userId == existing().userId;
      allow delete: if isAdmin();
    }
  }
}
